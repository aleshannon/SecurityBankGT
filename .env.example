# Deje estos valores vacíos para usar el motor de demostración incluido.
# Al completarlos, la aplicación usa Supabase Auth, PostgreSQL, RLS y Edge Functions.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# En el proyecto de Supabase, no en el frontend:
# SUPABASE_SERVICE_ROLE_KEY se configura solo como secreto de las Edge Functions.
# Para enviar el código, defina en los secretos de las funciones uno de estos canales:
# RESEND_API_KEY y MAIL_FROM. El envío sale por HTTPS; Gmail SMTP no funciona dentro de las funciones.
# DEMO_REVEAL_OTP=true muestra el OTP en pantalla, las cuentas de clase y la casilla de país. Déjelo sin definir para enviarlo solo por correo.
